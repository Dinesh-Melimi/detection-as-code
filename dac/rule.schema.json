{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detection rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "id", "status", "description", "author", "date", "tags", "logsource", "detection", "level", "falsepositives"],
  "properties": {
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {"enum": ["experimental", "test", "stable", "deprecated"]},
    "description": {"type": "string", "minLength": 20},
    "author": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "references": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^attack\\.([a-z-]+|t\\d{4}(\\.\\d{3})?)$"}
    },
    "logsource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": {
        "product": {"type": "string"},
        "category": {"type": "string"},
        "service": {"type": "string"}
      },
      "oneOf": [{"required": ["category"]}, {"required": ["service"]}]
    },
    "detection": {
      "type": "object",
      "required": ["condition"],
      "properties": {"condition": {"type": "string", "minLength": 1}},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/selection"},
          {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection"}}
        ]
      }
    },
    "correlation": {
      "type": "object",
      "required": ["type", "group_by", "timeframe"],
      "properties": {
        "type": {"enum": ["event_count", "value_count", "sequence"]},
        "group_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeframe": {"type": "string", "pattern": "^\\d+[smhd]$"},
        "threshold": {"type": "integer", "minimum": 1},
        "field": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selection"],
            "properties": {
              "selection": {"type": "string"},
              "min_count": {"type": "integer", "minimum": 1}
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "event_count"}}},
         "then": {"required": ["threshold"]}},
        {"if": {"properties": {"type": {"const": "value_count"}}},
         "then": {"required": ["threshold", "field"]}},
        {"if": {"properties": {"type": {"const": "sequence"}}},
         "then": {"required": ["steps"]}}
      ]
    },
    "falsepositives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "level": {"enum": ["informational", "low", "medium", "high", "critical"]}
  },
  "$defs": {
    "scalar": {"type": ["string", "integer", "number", "boolean", "null"]},
    "selection": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9_.@]+(\\|[a-z]+)*$"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/scalar"},
          {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}
        ]
      }
    }
  }
}
